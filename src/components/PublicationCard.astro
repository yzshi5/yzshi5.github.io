---
import type { Publication } from "../data/publications";

interface Props {
  publication: Publication;
  featured?: boolean;
}

interface ResourceLink {
  label: string;
  href: string;
}

const { publication, featured = false } = Astro.props;
const resourceLinks: ResourceLink[] = [];

if (publication.paper) resourceLinks.push({ label: "Paper", href: publication.paper });
if (publication.arxiv) resourceLinks.push({ label: "arXiv", href: publication.arxiv });
if (publication.code) resourceLinks.push({ label: "GitHub", href: publication.code });
if (publication.project) resourceLinks.push({ label: "Project", href: publication.project });

const primaryLink = publication.paper ?? publication.arxiv ?? publication.project;
---

<article
  class:list={["publication-card", { "publication-card--featured": featured }]}
  itemscope
  itemtype="https://schema.org/ScholarlyArticle"
>
  {
    featured && publication.image ? (
      <figure class="featured-publication-media">
        <img
          src={publication.image}
          alt={publication.imageAlt ?? ""}
          loading="lazy"
          decoding="async"
          itemprop="image"
        />
      </figure>
    ) : (
      <span class="publication-number" aria-label={`Publication ${publication.number}`}>
        [{publication.number}]
      </span>
    )
  }

  <div class="publication-content">
    <h3 itemprop="headline">
      {
        primaryLink ? (
          <a
            href={primaryLink}
            target={primaryLink.startsWith("http") ? "_blank" : undefined}
            rel={primaryLink.startsWith("http") ? "noreferrer" : undefined}
          >
            {publication.title}
          </a>
        ) : (
          publication.title
        )
      }
    </h3>

    <p class="publication-authors">
      {
        publication.authors.map((author, index) => (
          <>
            <span itemprop="author" itemscope itemtype="https://schema.org/Person">
              {author === "Yaozhong Shi" ? (
                <strong itemprop="name">{author}</strong>
              ) : (
                <span itemprop="name">{author}</span>
              )}
            </span>
            {index < publication.authors.length - 1 ? ", " : ""}
          </>
        ))
      }
    </p>

    <p class="publication-meta">
      <em itemprop="isPartOf">{publication.venue}</em>,{
        " "
      }<time itemprop="datePublished" datetime={String(publication.year)}>
        {publication.year}
      </time>{publication.award ? ". " : "."}
      {publication.award && <strong class="publication-award">{publication.award}</strong>}
    </p>

    {
      resourceLinks.length > 0 && (
        <div class="publication-links" aria-label={`Resources for ${publication.title}`}>
          {resourceLinks.map((link) => (
            <a
              class="text-link"
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            >
              {link.label}
              {link.href.startsWith("http") && <span aria-hidden="true">↗</span>}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
