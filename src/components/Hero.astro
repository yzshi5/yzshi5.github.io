---
import { site } from "../data/site";

const emailLink = site.links.find((link) => link.label === "Email");
---

<aside class="profile-panel" aria-labelledby="profile-name">
  <figure class="profile-portrait">
    <img
      src={site.profileImage}
      alt={site.profileAlt}
      width="720"
      height="720"
      loading="eager"
      fetchpriority="high"
    />
  </figure>

  <h1 id="profile-name">{site.name}</h1>
  <p class="profile-role">{site.role}</p>
  <p class="profile-institution">{site.institution}</p>

  {
    emailLink && (
      <a class="profile-email" href={emailLink.href}>
        yshi5@caltech.edu
      </a>
    )
  }

  <div class="profile-links" aria-label="Profile and contact links">
    {
      site.links.map((link) => (
        <a
          class="profile-link"
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noreferrer" : undefined}
          aria-label={link.label}
          title={link.label}
        >
          {link.label === "Google Scholar" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.5 9 12 4l9.5 5L12 14 2.5 9Z" />
              <path d="M6 11.2V16c1.7 1.4 3.7 2.1 6 2.1s4.3-.7 6-2.1v-4.8" />
            </svg>
          )}
          {link.label === "GitHub" && (
            <svg class="icon-solid" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.7a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.1 9.1 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.6 0 3.7-2.4 4.5-4.6 4.7.4.3.7.9.7 1.8v2.8c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.7Z" />
            </svg>
          )}
          {link.label === "CV" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 2.8h8l4 4V21H6V2.8Z" />
              <path d="M14 2.8V7h4M8.5 11.2h7M8.5 14.5h7M8.5 17.8h4.5" />
            </svg>
          )}
          {link.label === "Email" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 5.5h18v13H3v-13Z" />
              <path d="m3.5 6 8.5 7 8.5-7" />
            </svg>
          )}
          <span class="sr-only">{link.label}</span>
        </a>
      ))
    }
  </div>
</aside>
